{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug dsa",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/dsa",
            "args": [
                "-I", "tests/ranges.bed",
                "-A", "tests/normal.bam",
                "-B", "tests/duplex.bam",
                "-C", "tests/SNP.sorted.bed.gz",
                "-R", "tests/hs37d5.fa",
                "-D", "tests/NOISE.sorted.bed.gz",
                "-x", "2",
                "-Q", "30",
                "-O", "out/"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "Build dsa",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
