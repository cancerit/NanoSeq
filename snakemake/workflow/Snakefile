from helpers import helpers

configfile: "config.yaml"

# rule target_neat:
#     input:
#         expand("neat/{lane}.neat.cram", lane=config["lanes"]),

samplesheet = helpers.parse_samplesheet(config["samplesheet"])

rule all:
    input:
        expand("neat/{sample}.neat.cram",
            sample = samplesheet.keys())

def get_lane_path(wildcards):
    return samplesheet[wildcards.sample][wildcards.lane]

rule add_read_bundles:
    input:
        get_lane_path
    output:
        "files/{sample}/{lane}.rb.bam",
    shell:
        """
        bamaddreadbundles --no-filter -I {input} -O {output}
        """


rule lane_dupmark:
    input:
        "files/{sample}/{lane}.rb.bam",
    output:
        "files/{sample}/{lane}.rb.dupmark.bam",
    shell:
        # output will have both samtools and biobambam optical duplicate tags
        # dt and od respectively...
        # -d is a guess for the optical duplicate distance.
        # Not using any compression threads...
        """
        samtools collate -Ou {input} | 
        samtools fixmate -um - - | 
        samtools sort -u - | 
        samtools markdup -d 100 -c --output-fmt CRAM --barcode-tag RB - {output}
        """

def get_lanes_for_sample(wildcards):
    return expand("files/{sample}/{lane}.rb.dupmark.bam",
        sample = wildcards.sample,
        lane = samplesheet[wildcards.sample].keys())

rule merge_lanes:
    input:
        lanes = get_lanes_for_sample
    output:
        "merged/{sample}.merged.bam"
    shell:
        """
        echo "TODO"
        """

rule merged_dupmark:
    input:
        "merged/{sample}.merged.bam"
    output:
        "merged/{sample}.dupmark.bam"
    singularity:
        config["sif"]
    shell:
        # additive dupmarking to pick up any cross lane RB duplicates.
        # collate/fixmate/sort may not be necessary.
        """
        samtools collate -Ou {input} | 
        samtools fixmate -um - - | 
        samtools sort -u - | 
        samtools markdup --output-fmt CRAM --barcode-tag RB - {output}
        """


rule make_neat_cram:
    input:
        "merged/{sample}.dupmark.bam",
    output:
        "neat/{sample}.neat.cram",
    singularity:
        config["sif"]
    shell:
        """
        samtools view --require-flags 2 --exclude-flags 3852 --with-header --cram ---output-fmt-option no_ref -o {output} {input}
        """


