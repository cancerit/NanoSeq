def get_lane_paths(sample_dir: str, sample_names: list[str]) -> list[str]:
    from Pathlib import path
    lanes_per_sample: list[list[Path]] = [Path("{}/{}/".format(sample_dir, sample)).glob("*.bam") for sample in samples]
    lane_paths: list[str]
    for pathlist in lanes_per_sample:
        for path in pathlist:
            lane_paths.append(str(path))
    return lane_paths
    

rule add_read_bundles:
    input:
        get_lane_paths("lanes", config["samples"]),
    output:
        "files/{sample}/{lane}.rb.bam",
    shell:
        """
        bamaddreadbundles --no-filter -I {input} -O {output}
        """


rule lane_dupmark:
    input:
        "files/{sample}/{lane}.rb.bam",
    output:
        "files/{sample}/{lane}.rb.dupmark.bam",
    shell:
        # output will have both samtools and biobambam optical duplicate tags
        # dt and od respectively...
        # -d is a guess for the optical duplicate distance.
        # Not using any compression threads...
        """
        samtools collate -Ou {input} | 
        samtools fixmate -um - - | 
        samtools sort -u - | 
        samtools markdup -d 100 -c --output-fmt CRAM --barcode-tag RB - {output}
        """


