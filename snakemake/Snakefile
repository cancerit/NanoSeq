rule merged_dupmark:
    input:
        "merged/{sample}.bam"
    output:
        "merged/{sample}.dupmark.bam"
    singularity:
        config["sif"]
    shell:
        # additive dupmarking to pick up any cross lane RB duplicates.
        # collate/fixmate/sort may not be necessary.
        """
        samtools collate -Ou {input} | 
        samtools fixmate -um - - | 
        samtools sort -u - | 
        samtools markdup --output-fmt CRAM --barcode-tag RB - {output}
        """


rule make_neat_cram:
    input:
        "merged/{sample}.dupmark.bam",
    output:
        "neat/{sample}.neat.cram",
    singularity:
        config["sif"]
    shell:
        """
        samtools view --require-flags 2 --exclude-flags 3852 --with-header --cram ---output-fmt-option no_ref -o {output} {input}
        """


